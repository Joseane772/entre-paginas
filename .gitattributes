# Keep shell scripts LF on every OS: a Windows checkout with CRLF breaks the container entrypoint.
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.gz binary
*.png binary
*.ico binary
# Start/stop scripts for people who just double-click: Windows needs CRLF, Mac/Linux need LF.
# -text keeps git from converting them (including in GitHub's "Download ZIP").
*.bat -text
*.command text eol=lf
