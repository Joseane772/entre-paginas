# Postgres (matches docker-compose.yml; host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://entrepaginas:entrepaginas@localhost:5433/entrepaginas

# Sent to Open Library and Wikidata, which ask clients to identify themselves.
# Put a project URL or contact address here before running large imports.
DATA_USER_AGENT="EntrePaginas/0.1 (development)"

# Optional. TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api).
# Without it, adaptations still come from Wikidata but without posters or pt-PT synopses.
TMDB_READ_TOKEN=

# Optional. Google Books API key; fills in PT-PT editions Open Library lacks.
GOOGLE_BOOKS_API_KEY=

# --- Accounts (Better Auth) ---------------------------------------------------
# Long random string that signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site. On Vercel it's worked out automatically if left empty.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that become admins when they sign up.
# If empty, the first account created becomes admin. Later: npm run make-admin -- email
ADMIN_EMAILS=

# Optional. "Continuar com Google" (https://console.cloud.google.com/apis/credentials);
# authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Mail for password resets, e.g. smtps://user:pass@smtp.example.com:465
# Without it the reset link is printed in the server log.
SMTP_URL=
MAIL_FROM="Entre Páginas <no-reply@example.com>"

# Book imports per reader per hour (admins aren't limited).
IMPORTS_PER_HOUR=10
